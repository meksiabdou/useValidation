{
  "version": "3.0.13",
  "license": "MIT",
  "main": "dist/index.cjs",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "start": "tsdx watch",
    "build": "tsdx build",
    "test": "tsdx test --passWithNoTests",
    "lint": "tsdx lint",
    "prepare": "tsdx build",
    "size": "size-limit",
    "analyze": "size-limit --why"
  },
  "peerDependencies": {
    "react": ">=16"
  },
  "husky": {
    "hooks": {
      "pre-commit": "tsdx lint"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "name": "@meksiabdou/usevalidation",
  "author": "Meksi Abdennour",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "size-limit": [
    {
      "path": "dist/usevalidation.cjs.production.min.js",
      "limit": "15 KB"
    },
    {
      "path": "dist/usevalidation.esm.js",
      "limit": "15 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.0.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "bunchee": "^6.9.4",
    "husky": "^9.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^12.0.1",
    "tsdx": "^2.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
